# Bulk SEC data and everything derived from it. Never in git.
data/

# Python
*.pyc
__pycache__/
.ipynb_checkpoints/
.venv/
venv/

# The API's dependencies are restored by Azure at deploy time from
# package.json; the tree itself is tens of thousands of files.
api/node_modules/

# Deployment artefacts and browser debug profiles -- both are build output that
# happens to land inside the working tree.
*.zip
.swa/
chrome-debug-profile/
# the leading dot is the name actually used on disk
.chrome-debug-profile/
.playwright/

# Secrets. SWA_DEPLOYMENT_TOKEN and AZURE_STORAGE_CONNECTION_STRING live in the
# environment or in Azure's configuration, never in a file here.
.env
.env.*
local.settings.json

# Pre-compressed assets are regenerated by src/web_assets.py from the sources
# beside them, so committing them would just be a second copy that can go stale.
webapp/**/*.gz

# Build artifacts staged for Cloud Shell upload; rebuildable, never committed.
dist/

# Legacy binary reporting prototype; the current application does not read it.
*.pbix

# Editor and manual backup copies can retain obsolete embedded credentials.
*.bak

# Generated CRM lookup artifacts are rebuilt by the ACT export scripts.  They
# contain internal record identifiers and must not become permanent Git history.
api/shared/act_contacts.json
api/shared/act_mail_codes.json

